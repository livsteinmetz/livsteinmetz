{
  "hosting": {
    "site": "livsteinmetz",
    "public": "build",
    "ignore": ["firebase.json","**/.*","**/node_modules/**"],
    "rewrites": [
      { "source": "**", "destination": "/index.html" }
    ]
  },
  "firestore": {
    "database": "(default)",
    "location": "us-east1",
    "rules": "firestore.rules",
    "indexes": "firestore.indexes.json"
  }
}
