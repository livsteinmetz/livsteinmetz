generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite" // dev. Switch to postgres in prod.
  url      = env("DATABASE_URL")
}

model Reflection {
  id          String   @id @default(cuid())
  title       String
  citation    String
  sourceUrl   String?  @unique
  tags        String   // store as comma-separated list, e.g. "constructivism, design"
  theoryLens  String?
  summary     String
  reflection  String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model User {
  id       String @id @default(cuid())
  email    String @unique
  passHash String
}

